\date{2026-02-09T12:30:11Z}
\tag{discrete}
\taxon{Example}

\import{discrete-macros}

\p{Write an outline for a proof of #{P \implies (Q \land R)}.}

\proof{
  We must prove #{P \implies (Q \land R)}.  So suppose #{P} is true; we will
  show #{(Q \land R)}.
  \subproof{
    To show #{(Q \land R)}, we will show both separately.
    \subproof{
      \em{Proof of #{Q}, using #{P}}
    }
    \subproof{
      \em{Proof of #{R}, using #{P}}
    }
    Since we showed #{Q}, and #{R}, therefore #{Q \land R}.
  }
  Since we showed #{Q \land R} under the supposition #{P}, therefore #{P
  \to (Q \land R)}.
}
