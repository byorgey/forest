\date{2025-11-03T15:55:01Z}
\title{Requirement contexts}
\taxon{Definition}

\import{swarm-macros}

\p{A \em{requirement context} #{\Phi} is a triple #{(\Delta,D,I)} where
  \ul{
    \li{#{\Delta \subseteq \capset} is a set of [capabilities](001D), representing capabilities a robot should have,}
    \li{#{D \subseteq \entset} is a set of [entities](001C), representing [devices](001E) that should be equipped,}
    \li{#{I} is an [inventory](0012), representing entities that a robot should possess.}
  }
}

\transclude{001K}
\transclude{0010}
\transclude{0011}
\transclude{0016}
\transclude{001L}