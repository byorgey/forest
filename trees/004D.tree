\date{2026-02-02T18:17:36Z}
\tag{discrete}
\taxon{Example}

\import{discrete-macros}

\p{Simplify: #{\neg (p \implies \neg(\neg q \lor (r \land q)))}.}

\stmt{\neg (p \implies \neg(\neg q \lor (r \land q)))}
\reason{\equiv}{distributivity}
\stmt{\neg (p \implies \neg((\neg q \lor r) \land (\neg q \lor q)))}
\reason{\equiv}{excluded middle}
\stmt{\neg (p \implies \neg((\neg q \lor r) \land \True))}
\reason{\equiv}{identity}
\stmt{\neg (p \implies \neg(\neg q \lor r))}
\reason{\equiv}{de Morgan}
\stmt{\neg (p \implies (\neg\neg q \land \neg r))}
\reason{\equiv}{double negation}
\stmt{\neg (p \implies (q \land \neg r))}
\reason{\equiv}{implication}
\stmt{\neg (\neg p \lor (q \land \neg r))}
\reason{\equiv}{de Morgan, double negation}
\stmt{p \land \neg (q \land \neg r)}
\reason{\equiv}{de Morgan, double negation}
\stmt{p \land (\neg q \lor r)}
