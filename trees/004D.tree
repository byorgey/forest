\date{2026-02-02T18:17:36Z}
\tag{discrete}
\taxon{Example}

\import{discrete-macros}

\p{Simplify: #{\neg (p \implies \neg(\neg q \lor (r \land q)))}.}

##{
  \begin{align*}
    &\neg (p \implies \neg(\neg q \lor (r \land q))) \\
    &\equiv\quad\quad\quad\{ \text{distributivity} \} \\
    &\neg (p \implies \neg((\neg q \lor r) \land (\neg q \lor q))) \\
    &\equiv\quad\quad\quad\{ \text{excluded middle} \} \\
    &\neg (p \implies \neg((\neg q \lor r) \land \True)) \\
    &\equiv\quad\quad\quad\{ \text{identity} \} \\
    &\neg (p \implies \neg(\neg q \lor r)) \\
    &\equiv\quad\quad\quad\{ \text{de Morgan} \} \\
    &\neg (p \implies (\neg\neg q \land \neg r)) \\
    &\equiv\quad\quad\quad\{ \text{double negation} \} \\
    &\neg (p \implies (q \land \neg r)) \\
    &\equiv\quad\quad\quad\{ \text{implication} \} \\
    &\neg (\neg p \lor (q \land \neg r)) \\
    &\equiv\quad\quad\quad\{ \text{de Morgan, double negation} \} \\
    &p \land \neg (q \land \neg r) \\
    &\equiv\quad\quad\quad\{ \text{de Morgan, double negation} \} \\
    &p \land (\neg q \lor r) \\
  \end{align*}
}
