\export{base-macros}

\def\sf[it]{#{\mathsf{\it}}}
\def\bf[it]{#{\mathbf{\it}}}
\def\bb[it]{#{\mathbb{\it}}}

\def\capset{\bf{C}}
\def\entset{\bf{E}}
\def\caps{\sf{caps}}
\def\devs{\sf{provision}}

\def\toinv[E]{#{\lceil\E\rceil}}

\def\Ninf{#{\bb{N}_\infty}}

\def\Void{\sf{Void}}
\def\Unit{\sf{Unit}}
\def\Int{\sf{Int}}
\def\Text{\sf{Text}}
\def\Bool{\sf{Bool}}
\def\Dir{\sf{Dir}}
\def\Key{\sf{Key}}
\def\Actor{\sf{Actor}}
\def\true{\sf{true}}
\def\false{\sf{false}}
\def\undef{\sf{undefined}}
\def\delay{\sf{delay}}
\def\force{\sf{force}}
\def\case{\sf{case}}
\def\match{\sf{match}}
\def\build[p]{#{\sf{build}\;p}}

\def\Cmd[cap][res]{#{\sf{Cmd}^{\cap}\;\res}}
\def\Delay[cap][res]{#{\sf{Delay}^{\cap}\;\res}}
\def\Fun[src][cap][tgt]{#{\src \xrightarrow{\cap} \tgt}}
\def\Exc[c]{#{\sf{Exc}(\c)}}
\def\sequence[c1][c2]{#{\c1;\; \c2}}

\def\recty[X][body]{#{\mu \X.\; \body}}

\def\swtop[ctx][t][ty]{#{\ctx \vdash \t : \ty}}

\def\swtygen[ctx][rctx][t][rel][ty]{#{\ctx \vdash \t \rel \ty \;[\rctx]}}
\def\swty[ctx][t][ty][rctx]{\swtygen{\ctx}{\rctx}{\t}{:}{\ty}}
\def\swinfer[ctx][t][ty][rctx]{\swtygen{\ctx}{\rctx}{\t}{\triangleright}{\ty}}
\def\swcheck[ctx][t][ty][rctx]{\swtygen{\ctx}{\rctx}{\t}{\triangleleft}{\ty}}

\def\swpoly[tyvars][caps][ty]{#{\all{\tyvars}{\caps \Rightarrow \ty}}}

\def\bind{#{\leftarrow}}

\def\rules[~body]{
  \scope{
    \figure{
      \tex{\usepackage{mathpartir}\usepackage{amssymb}\usepackage{mathtools}}{$\body{}$}
    }
  }
}
