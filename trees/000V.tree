\date{2025-11-03T00:05:19Z}
\title{Swarm typing judgments}
\tag{swarm}
\tag{note}

\import{swarm-macros}

\p{Swarm has two basic typing judgments: a [top-level judgment](001M) that assigns capability-annotated [polytypes](001N), and a [basic judgment](001O) that assigns [monotypes](000Y) to terms and collects the [capabilities](001D) needed to evaluate them.}

\transclude{001M}    % top-level typing judgment
\transclude{001O}    % basic judgment
\transclude{001Q}    % Remark: basic judgment re: *evaluation* vs execution.
\transclude{001R}    % Remark: capability set part of judgment vs part of type
\transclude{001P}    % Gen/inst
