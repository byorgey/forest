\title{Distributivity of intersection over union}
\date{2026-02-27T11:43:20Z}
\tag{discrete}

\import{discrete-macros}

\taxon{Theorem}

\p{For all sets #{A}, #{B}, and #{C}, ##{A \cap (B \cup C) = (A \cap B) \cup (A \cap C).}}

\proof{
  Let #{A}, #{B}, and #{C} be arbitrary sets.  Then we will show that #{x \in A \cap (B \cup C) \equiv x \in (A \cap B) \cup (A \cap C)} for arbitrary #{x}.

\stmt{x \in A \cap (B \cup C)}
\reason{\equiv}{definition of intersection}
\stmt{x \in A \land x \in B \cup C}
\reason{\equiv}{definition of union}
\stmt{x \in A \land (x \in B \lor x \in C)}
\reason{\equiv}{distributivity of #{\land} over #{\lor}}
\stmt{(x \in A \land x \in B) \lor (x \in A \land x \in C)}
\reason{\equiv}{definition of intersection}
\stmt{(x \in A \cap B) \lor (x \in A \cap C)}
\reason{\equiv}{definition of union}
\stmt{x \in (A \cap B) \cup (A \cap C)}

}
