\date{2026-02-11T11:59:06Z}
\tag{discrete}
\taxon{Example}

\import{discrete-macros}

\p{Prove that #{(2n + 1 > 6) \to (n > 2)}.}

\subtree{\p{
  \taxon{Proof}
  \p{To prove #{(2n + 1 > 6) \to (n > 2)}, suppose #{(2n + 1 > 6)}, then we must show #{(n > 2)}.}
  \subtree{\p{
    Starting from #{(2n + 1 > 6)} we can reason as follows:
    ##{\begin{align*}
      & 2n+1 > 6 \\
      & \to \quad\quad\quad \{\text{subtract 1 from both sides}\} \\
      & 2n > 5 \\
      & \to \quad\quad\quad \{\text{divide both sides by 2}\} \\
      & n > 5/2 \\
      & \to \quad\quad\quad \{5/2 > 2 \text{, and } > \text{ is transitive}\} \\
      & n > 2
    \end{align*}}
  }}
\p{Therefore, since we have shown that #{n > 2} must be true under the assumption that #{2n + 1 > 6}, therefore #{(2n+1 > 6) \to (n > 2)}.}

}}
