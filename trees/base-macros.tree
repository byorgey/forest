\title{Basic macros}

\xmlns:html{http://www.w3.org/1999/xhtml}

\def\tt[body]{\code{\body}}

\def\table[body]{
  \<html:table>{\body}
}
\def\tr[body]{
  \<html:tr>{\body}
}
\def\td[body]{
  \<html:td>{\body}
}
\def\th[body]{
  \<html:th>{\body}
}
\def\hr{
  \<html:hr>{}
}

\def\mark[body]{\<html:mark>{\body}}

\def\img[url]{
  \<html:img>[src]{\url}{}
}
\def\imgasset[file]{
  \img{\route-asset{assets/images/\file}}
}

\def\rel/my-references{brentyorgey.query.my-references}
\execute\datalog{
 \rel/my-references ?X -: {\rel/has-author ?X @{brentyorgey}} {\rel/is-reference ?X}
}

\def\home[sub]{http://ozark.hendrix.edu/~yorgey/\sub}
\def\pub[sub]{\home{pub/\sub}}
\def\blog[sub]{https://byorgey.github.io/blog/\sub}

\def\N{#{\mathbb{N}}}
\def\lam[x][body]{#{\lambda \x.\; \body}}
\def\lamt[x][ty][body]{#{\lambda \x : \ty.\; \body}}
\def\app[x][y]{#{\x\; \y}}