\date{2025-11-03T15:56:26Z}
\title{Capability context satisfaction}
\taxon{Definition}

\import{swarm-macros}

\p{A robot with equipped device set #{Q} and inventory #{V} \em{satisfies} the [capability context](000Z) #{\Delta = (C,D,I)} if #{C \subseteq \caps(Q)}, #{D \subseteq Q}, and #{I \subseteq V}. In other words, a robot satisfies a capability context if its equipped devices provide at least the required capabilities, it has all the required devices equipped, and its inventory contains at least the required entity counts.}
