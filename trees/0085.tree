\title{Characterization of subset via union}
\date{2026-02-27T11:51:08Z}
\tag{discrete}

\import{discrete-macros}

\taxon{Theorem}
\p{For all sets #{A} and #{B}, ##{(A \subseteq B) \iff (A \cup B = B).}}

\proof{
  Let #{A} and #{B} be arbitrary sets.  We must prove both directions of the if and only if.

\subproof{
  #{(A \subseteq B) \implies (A \cup B = B).}  Suppose #{A \subseteq B}.  Then we must show #{A \cup B = B}, which we do by showing both #{A \cup B \subseteq B} and #{B \subseteq A \cup B}.
  \subproof{
    To show that #{A \cup B \subseteq B}, let #{x \in A \cup B} be arbitrary; we must show #{x \in B}.  Since #{x \in A \cup B}, by definition #{x \in A \lor x \in B}.  To prove #{x \in B} we must therefore show both #{x \in A \implies x \in B} and #{x \in B \implies x \in B}.
    \subproof{#{x \in A \implies x \in B} is true since we supposed #{A \subseteq B}.}
    \subproof{#{x \in B \implies x \in B} is true since #{P \implies P} is always true for any proposition #{P}.}
  }

  \subproof{
    To show that #{B \subseteq A \cup B}, let #{x \in B} be arbitrary; we must show #{x \in A \cup B}, that is, #{x \in A \lor x \in B}.  But we already know #{x \in B}, hence #{x \in A \lor x \in B}.
  }
}
\subproof{
#{(A \cup B = B) \implies (A \subseteq B).}  Suppose #{A \cup B = B}; we will show #{A \subseteq B}.
  \subproof{
    To show #{A \subseteq B}, let #{x \in A} be arbitrary; we must show #{x \in B}.
    \subproof{
      Since #{x \in A}, then #{x \in A \cup B} also.  But we supposed #{A \cup B = B}, and hence #{x \in B}.
    }
  }
}
}
