\export{base-macros}

\def\implies{\rightarrow}
\def\iff{\leftrightarrow}
\def\term[body]{\em{\body}}

\def\st{.\;}
\def\all[var][dom]{\forall {\var}: {\dom}\st}
\def\ext[var][dom]{\exists {\var}: {\dom}\st}

\def\Even{\mathrm{Even}}
\def\Odd{\mathrm{Odd}}
\def\Rational{\mathrm{Rational}}
\def\Irrational{\mathrm{Irrational}}
\def\Prime{\mathrm{Prime}}

\def\ps[body]{#{\mathcal{P}(\body)}}

\def\difference{\mathbin{\backslash}}
\def\union{\cup}
\def\intersect{\cap}
\def\intersection{\cap}
