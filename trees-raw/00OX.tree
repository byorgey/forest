\title{Kruskal's Algorithm}
\date{2026-10-12T13:39:58Z}
\tag{algorithms}
\taxon{Algorithm}

\import{algorithms-macros}

\pseudo{
  \state{\sf{Kruskal}#{(G = (V,E)):}}
  \indent{
  \state{#{T \gets} empty set}
  \state{Sort the edges #{E} from smallest to biggest weight}
  \for{each edge #{e} from smallest to biggest weight}{
    \if{#{e} does not complete a cycle with other edges already in #{T}}{
      \state{Add #{e} to #{T}}
    }
  }
  }
}
