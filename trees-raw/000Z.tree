\date{2025-11-03T15:55:01Z}
\title{Requirement contexts}
\taxon{Definition}

\import{swarm-macros}

\p{A \em{requirement context} #{\Phi} is a triple #{(\Delta,D,I)} where
  \ul{
    \li{#{\Delta \subseteq \capset} is a [set expression](001Y) over [capabilities](001D), representing a set of capabilities that a [robot](0014) should have;}
    \li{#{D \subseteq \entset} is a [set expression](001Y) over [entities](XXX), representing a set of [devices](001E) that should be equipped;}
    \li{#{I} is a [bag expression](001Y) over [entities](XXX), representing the [inventory](0012) that a [robot](0014) should possess.}
  }
}

\transclude{001K}
\transclude{0010}
\transclude{0011}
\transclude{0016}
\transclude{001L}
