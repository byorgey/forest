\date{2026-01-31T19:26:55Z}
\tag{discrete}
\taxon{Example}

\import{discrete-macros}

\p{Prove #{(p \implies q) \land (p \implies r) \equiv p \implies (q
  \land r)}.}

##{
  \begin{align*}
    &(p \implies q) \land (p \implies r) \\
    &\equiv\quad\quad\quad\{\text{Implication, twice}\} \\
    & (\neg p \lor q) \land (\neg p \lor r) \\
    & \equiv\quad\quad\quad\{\text{Factor out $\neg p$ (distributivity, backwards)}\} \\
    & \neg p \lor (q \land r) \\
    & \equiv\quad\quad\quad \{\text{Implication}\} \\
    & p \implies (q \land r)
  \end{align*}
}
