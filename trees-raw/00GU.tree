\title{Functions}
\date{2026-06-10T21:05:25Z}
\import{swarm-macros}

\p{If #{\tau_1} and #{\tau_2} are types, and #{\Delta} is a capability set expression, the type \Fun{\tau_1}{\Delta}{\tau_2} represents functions which, when applied to an argument of type #{\tau_1}, produce a result of type #{\tau_2} using capabilities #{\Delta}.  We use #{\tau_1 \to \tau_2} as an abbreviation for \Fun{\tau_1}{\varnothing}{\tau_2}, a function which requires no capabilities to apply.}

\transclude{001A}
