\title{Iterative Euclidean Algorithm}
\date{2026-09-02T13:44:13Z}
\tag{algorithms}

\import{algorithms-macros}

\p{The second implementation of the Euclidean Algorithm is iterative:}

\pseudo{
\state{\sf{GCDI}#{(m,n) =}}
\indent{
  \state{#{a \gets m}}
  \state{#{b \gets n}}
  \while{#{(a \neq 0)} \keyword{and} #{(b \neq 0)}}{
    \if{#{a \leq b}}{
      \state{#{b \gets b \bmod a}}
    }
    \else{
      \state{#{a \gets a \bmod b}}
    }
  }
  \state{\keyword{if} #{a = 0} \keyword{then} \return #{b} \keyword{else} \return #{a}}
}
}
