\export{base-macros}

\def\st{.\;}
\def\all[var][dom]{\forall {\var}: {\dom}\st}
\def\ext[var][dom]{\exists {\var}: {\dom}\st}

\def\hint[body]{
  \put\transclude/expanded{false}
  \subtree{\taxon{Hint}
    \p{\body}
  }
}

\def\acode[body]{
  \p{
    \tex{\usepackage{../../tex/acode}}{\begin{acode}\body\end{acode}}
  }
}
