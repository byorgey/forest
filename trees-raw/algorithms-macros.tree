\export{base-macros}
\export{pseudocode}

\def\st{.\;}
\def\all[var][dom]{\forall {\var}: {\dom}\st}
\def\ext[var][dom]{\exists {\var}: {\dom}\st}

\def\hint[body]{
  \put\transclude/expanded{false}
  \put\transclude/numbered{false}
  \subtree{\taxon{Hint}
    \p{\body}
  }
}

\def\sf[body]{#{\mathsf{\body}}}
\def\GCDR{\sf{GCDR}}
\def\GCDI{\sf{GCDI}}
\def\DFS{\sf{DFS}}
\def\BFS{\sf{BFS}}
