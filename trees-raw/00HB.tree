\title{[CW03] Waltz in A minor, Op. 34 No. 2}
\author{chopin}

\import{base-macros}
\tag{repertoire}
\tag{polished}

\lilypond{\verb<<<|
\new PianoStaff <<
  \new Staff \relative
  { \time 3/4 \key a \minor \tempo Lento
    r4 \p <c' e>( <c a'>) |
    r <b d>( <b a'>)
  }
  \new Staff
  { \clef bass \key a \minor
    <<
    \new Voice = "first"
      \relative { \voiceOne e2( d8 e | f2 g8 f) }
    \new Voice = "second"
     \relative { \voiceTwo a,2.~ | a }
    >>
  }
>>
<<<}
