\li{[Freckles](https://open.kattis.com/problems/freckles)}
\li{[Lost Map](https://open.kattis.com/problems/lostmap)}
\li{[Treehouses](https://open.kattis.com/problems/treehouses)}
\li{[Arctic Network](https://open.kattis.com/problems/arcticnetwork)}
\li{[Edge Removal](https://open.kattis.com/problems/edgeremoval)}
}
