\title{Recursive Euclidean Algorithm}
\date{2026-09-02T13:43:35Z}
\tag{algorithms}

\import{algorithms-macros}

\p{The first implementation of the Euclidean Algorithm is recursive:}

\pseudo{
\state{\sf{GCDR}#{(a,b) =}}
\indent{
\state{\keyword{if} #{b = 0}}
\indent{
  \state{\keyword{then} #{a}}
  \state{\keyword{else} \sf{GCDR}#{(b, a \bmod b)}}
}
}
}
