\title{Triangular numbers}
\date{2026-03-18T13:25:24Z}
\tag{discrete}
\taxon{Example}

\import{discrete-macros}

\pre\verb<<<|
tri : N -> N
tri(0) = 0
tri(n) = n + tri(n .- 1)
<<<

\p{Instead of using \code{:table} we can also create a [list](https://disco-lang.readthedocs.io/en/latest/reference/list.html) to see exactly the part of the sequence we want.  We can use the [\code{each} function](https://disco-lang.readthedocs.io/en/latest/reference/each.html) to apply \code{tri} to each index in a list.}

\pre\verb<<<|
Disco> each(tri, [0 .. 10])
[0, 1, 3, 6, 10, 15, 21, 28, 36, 45, 55]
<<<
