\tag{discrete}

\import{discrete-macros}

\taxon{Example}
\p{##{\begin{align*}
    &\phantom{=} \gcd(60, 18) \\
    &= \gcd(42, 18) \\
    &= \gcd(24, 18) \\
    &= \gcd(6, 18) \\
    &= \gcd(18, 6) \\
    &= \gcd(12, 6) \\
    &= \gcd(6, 6) \\
    &= \gcd(0, 6) \\
    &= \gcd(6, 0) \\
    &= 6
\end{align*}}}
