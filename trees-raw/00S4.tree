\title{Greedy Flow}
\date{2026-11-11T14:51:17Z}
\tag{algorithms}
\taxon{Algorithm}

\import{algorithms-macros}

\pseudo{
\state{Initialize #{f(e) \gets 0} for all #{e \in E}}
\while{there is any unsaturated path #{P} from #{s} to #{t}}{
  \state{#{\alpha \gets} minimum remaining capacity #{c(e) - f(e)} among all edges #{e \in P}}
  \for{each edge #{e \in P}}{
    \state{#{f(e) \gets f(e) + \alpha}}
  }
}
}
