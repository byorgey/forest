\title{Kahn's Algorithm}
\date{2026-09-24T16:09:24Z}
\tag{algorithms}
\taxon{Algorithm}

\import{algorithms-macros}

\p{The resulting algorithm is known as \em{Kahn’s Algorithm}, and was first published by Arthur Kahn in 1962.}

\pseudo{
\state{\sf{Kahn}#{(G):}}
\indent{
  \state{#{T \gets} empty list}
  \state{#{Z \gets} empty queue/stack/whatever (with #{\Theta(1)} add/remove)}
  \state{#{\mathit{in} \gets} dictionary mapping all vertices to #{0}}
  \for{each #{v \in V}}{
    \for{each #{u} adjacent to #{v}}{
      \state{increment #{\mathit{in}[v]}}
    }
  }
  \for{each #{v \in V}}{
    \if{#{\mathit{in}[v] = 0}}{
      \state{add #{v} to #{Z}}
    }
  }
  \while{#{Z} is not empty}{
    \state{#{v \gets Z.\mathit{dequeue}}}
    \state{append #{v} to #{T}}
    \for{each #{u} adjacent to #{v}}{
      \state{decrement #{\mathit{in}[u]}}
      \if{#{\mathit{in}[u] = 0}}{
        \state{add #{u} to #{Z}}
      }
    }
  }
}}

