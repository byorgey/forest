\tag{discrete}
\taxon{Example}

\import{discrete-macros}

\ul{
  \li{#{\{1,3,6\} \subseteq \{2,3,7,6,1\}}: each element of the set #{\{1,3,6\}} is also an element of #{\{2,3,7,6,1\}}.}
  \li{#{\{1,3,6\} \subseteq \N}.}
  \li{#{\{1,3,6\} \not \subseteq \{2,7,6,1\}}, since #{3} is an element of the first set but not the second.}
}
